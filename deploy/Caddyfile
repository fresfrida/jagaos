# JagaOS — reverse proxy config
# Caddy auto-provisions TLS via Let's Encrypt on first run.
# Swap :80 for your real domain/Lightsail static IP's DNS name once known;
# Caddy also serves plain HTTP+auto-redirect if you only have a bare IP.
#
# Two site addresses, same block (nip.io's wildcard resolves any subdomain in front of the
# dashed IP to that IP, so jagaos.13-251-52-222.nip.io is the same host): the branded one is
# the one to hand out, and the bare one stays live so nothing already pointed at it breaks
# (web/.env.local, older bookmarks/screenshots).

jagaos.13-251-52-222.nip.io, 13-251-52-222.nip.io {
	encode gzip

	# backend (same origin as the site, so no CORS setup is needed)
	handle /api/* {
		# Round 20 (DECISIONS #99): an outer bound on any request body, so an absurd upload is refused here
		# before it reaches the API. The API enforces the real per-file limit (25 MB, app/limits.py) and its
		# own body bound (26 MiB for one file, 51 MiB for several pages); this is the ceiling above both.
		request_body {
			max_size 52MiB
		}
		reverse_proxy 127.0.0.1:8000
	}

	handle /assets/* {
		root * /var/www/jaga/web
		file_server
	}

	# Submission media (2026-09-28): the demo video and the two PDFs (and, later, the narration track) at a
	# STABLE path — file_server serves byte-range requests and sets Content-Type from the extension on its
	# own, so this needs no special config for either. `root` is the PARENT of the actual media/ folder, the
	# same pattern /assets/* uses one block up (root the parent, so the request's own /media/* prefix walks
	# into the media/ folder that sits under it) — root * /var/www/jaga/media here would double the segment
	# and look for .../jaga/media/media/<file>, a 404 caught live on first deploy. The files underneath get
	# swapped in place (same path, same URL) as newer cuts arrive; nothing here changes when they do.
	# Directory listing is off on purpose (browse), so a file that has not arrived yet (the narration track)
	# answers 404, not a listing.
	handle /media/* {
		root * /var/www/jaga
		file_server
	}

	# everything else: root files (icon-32/192/512.png, apple-touch-icon.png, manifest.webmanifest, index.html)
	# with SPA fallback. Must stay last so /api/* and /assets/* win.
	handle {
		root * /var/www/jaga/web
		try_files {path} /index.html
		file_server
	}

	# never let a static crawler or the internet at large index the demo
	header X-Robots-Tag "noindex"
}
