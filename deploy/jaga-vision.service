[Unit]
Description=JagaOS Vision (local image captioning, isolated venv)
After=network.target

[Service]
Type=simple
User=jaga
WorkingDirectory=/opt/jaga/vision
ExecStart=/opt/jaga/vision/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8100
Restart=on-failure
RestartSec=5

# Resource isolation, not a suggestion (2026-09-23, DECISIONS #55): the
# model peaks at ~2GB RSS while loaded (measured) on a box with 4GB total
# RAM already running jaga-api, Caddy, SQLite, and Tesseract. 2.5G leaves
# real headroom above that measured peak without being unbounded — if
# this service ever exceeds it (a bug, a much larger image than tested,
# concurrent requests each loading their own model copy), systemd kills
# only this service, never the box. Restart=on-failure above means a kill
# doesn't leave it permanently dead.
#
# IMPORTANT — verify this actually fires before trusting it: see
# deploy/README.md's "Verifying jaga-vision.service" section for the
# systemd-run --scope smoke test. This could not be verified locally
# (no systemd on macOS) — confirm on the box itself after deploying.
MemoryMax=2.5G

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
