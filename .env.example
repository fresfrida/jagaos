# Copy to .env (never commit .env itself)

# Gateway (STRATEGY.md): OpenAI-compatible, model aliases sonnet4.5 / haiku
LLM_GATEWAY_BASE_URL=https://api.softwaresystems.app/v1
LLM_GATEWAY_API_KEY=
# 2026-09-24 (item 3, portability audit): only "sonnet4.5" is approved on
# this project's current gateway key (GAPS.md §11) — that's a fact about
# this key, not something that belongs hardcoded into every call site.
LLM_MODEL_NAME=sonnet4.5
# Spend kill switch (round 7, DECISIONS #132). Set to 1 on a machine that must NEVER spend gateway budget: every call is refused
# before a client is built, and an upload that would need one gets a 503. Unset means calls are allowed (production on the box).
# LLM_CALLS_DISABLED=

# SQLite + document store (ARCHITECTURE.md §8)
JAGA_DB_PATH=./data/jaga.db
JAGA_DOCS_PATH=./data/docs
# Cached first-page JPEGs of PDFs, one per document content (app/thumbnails.py, DECISIONS #97). Derived data,
# safe to delete: it is rebuilt on the next request for each thumbnail.
JAGA_THUMBS_PATH=./data/thumbnails

# jaga-vision captioning service (DECISIONS #55) — same-box, localhost-only
# by default; app/main.py::CAPTION_SERVICE_URL. Read but never declared
# here before now (2026-09-24, item 7 lifecycle audit) — the opposite gap
# from JAGA_DOCS_PATH above (declared but unread): this one was unread-
# but-undeclared instead, silently defaulting with nothing here to tell a
# new environment it exists.
JAGA_VISION_URL=http://127.0.0.1:8100/caption

# Telegram push (deferred until the scheduler/escalation ladder is built)
TELEGRAM_BOT_TOKEN=

# 2026-09-24 (item 3, portability audit): comma-separated frontend origins
# CORS should accept — app/main.py's CORSMiddleware. Leave unset for the
# current local-dev + Vercel UAT defaults (hardcoded as the fallback, not
# lost by leaving this blank); set explicitly for a different deploy
# target (a different frontend domain, a staging environment).
CORS_ALLOWED_ORIGINS=
